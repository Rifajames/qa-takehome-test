{
	"info": {
		"_postman_id": "e59ed1b5-76c9-48a9-a5f9-80cdef34efd4",
		"name": "Swagger Petstore Manual Tests",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
